{
  "name": "@dahlia-ai/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared React UI, browser data layer and Documents core for Dahlia Web and Desktop",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./api/*": "./src/api/*.ts",
    "./app/*": "./src/app/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./documents/editor.css": "./src/documents/editor.css",
    "./documents/*": "./src/documents/*.ts",
    "./layout/*": "./src/layout/*.tsx",
    "./model/*": "./src/model/*.ts",
    "./screens/*": "./src/screens/*.tsx"
  },
  "scripts": {
    "check": "pnpm run documents:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "documents:build": "node scripts/document-assets.mjs",
    "documents:check": "node scripts/document-assets.mjs --check",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.2",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-unique-id": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "better-auth": "1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.46.0",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.6.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "yjs": "13.6.32",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
