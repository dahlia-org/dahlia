# Dedicated Hindsight database. Use a primary endpoint and TLS for Lakebase.
# Fill in the authenticated connection URL locally; require TLS with sslmode=require.
HINDSIGHT_API_DATABASE_URL=
HINDSIGHT_API_DATABASE_SCHEMA=hindsight
# Set separately if runtime and migration credentials differ:
# HINDSIGHT_API_MIGRATION_DATABASE_URL=postgresql://...
HINDSIGHT_API_TEXT_SEARCH_EXTENSION=lakebase_text
HINDSIGHT_API_VECTOR_EXTENSION=lakebase_vector

# Used only by lakebase_text for documents and queries.
HINDSIGHT_API_LAKEBASE_TEXT_TOKENIZER=hindsight_lakebase.tokenizer:sudachi

# Configure your existing model provider; model calls are independent of Lakebase.
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_API_KEY=
# HINDSIGHT_API_LLM_MODEL=
# HINDSIGHT_API_LLM_BASE_URL=
# The Databricks App lowers reasoning for fact extraction only (text and image):
# HINDSIGHT_API_RETAIN_LLM_REASONING_EFFORT=low
HINDSIGHT_API_EMBEDDINGS_PROVIDER=openai
HINDSIGHT_API_EMBEDDINGS_OPENAI_MODEL=text-embedding-3-small
# HINDSIGHT_API_EMBEDDINGS_OPENAI_API_KEY=
# HINDSIGHT_API_EMBEDDINGS_OPENAI_BASE_URL=
# rrf avoids downloading a model locally; the Databricks App uses the local cross-encoder (see README).
HINDSIGHT_API_RERANKER_PROVIDER=rrf

# Optional Dahlia screenshot ingestion (also requires Workspace admin opt-in).
# HINDSIGHT_API_VLM_PROVIDER=databricks
# HINDSIGHT_API_VLM_MODEL=system.ai.gpt-6-luna
# HINDSIGHT_API_LLM_VISION=true
# HINDSIGHT_API_LLM_TEMPERATURE_RETAIN=none
# HINDSIGHT_API_RETAIN_MAX_ATTACHMENTS_PER_CHUNK=1
# HINDSIGHT_API_RETAIN_ATTACHMENT_MAX_COUNT=8
# HINDSIGHT_API_RETAIN_ATTACHMENT_MAX_SIZE_MB=8
