{
  "name": "@dahlia/cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm run build:client && pnpm run build:server",
    "build:client": "vite build",
    "build:cloudflare": "WRANGLER_WRITE_LOGS=false WRANGLER_SEND_METRICS=false vite build --config vite.cloudflare.config.ts",
    "build:server": "tsup --config tsup.config.ts",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run worker:dry-run",
    "db:generate": "drizzle-kit generate",
    "db:generate-auth": "node scripts/generate-auth-schema.mjs",
    "db:migrate": "tsx --env-file-if-exists=../../.env.local src/db/migrate.ts",
    "db:migrate:d1:local": "WRANGLER_WRITE_LOGS=false WRANGLER_SEND_METRICS=false wrangler d1 migrations apply AUTH_DB --local",
    "db:migrate:prod": "node dist/server/db/migrate.js",
    "dev": "concurrently -k -n api,web \"pnpm run dev:api\" \"pnpm run dev:client\"",
    "dev:api": "tsx watch --env-file-if-exists=../../.env.local src/node.ts",
    "dev:client": "vite",
    "dev:cloudflare": "WRANGLER_WRITE_LOGS=false WRANGLER_SEND_METRICS=false vite dev --config vite.cloudflare.config.ts",
    "lint": "eslint .",
    "start": "node dist/server/node.js",
    "start:databricks": "pnpm run db:migrate:prod && pnpm run start",
    "predev": "pnpm run db:migrate",
    "preview:cloudflare": "WRANGLER_WRITE_LOGS=false WRANGLER_SEND_METRICS=false vite preview --config vite.cloudflare.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "worker:dev": "pnpm run dev:cloudflare",
    "worker:dry-run": "pnpm run build:cloudflare && WRANGLER_WRITE_LOGS=false WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --outdir dist/worker",
    "worker:types": "WRANGLER_WRITE_LOGS=false WRANGLER_SEND_METRICS=false wrangler types worker-configuration.d.ts"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "^1.7.0-rc.3",
    "@better-auth/stripe": "1.7.0-rc.3",
    "@hono/node-server": "^2.1.0",
    "better-auth": "^1.7.0-rc.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.0",
    "ipaddr.js": "^2.5.0",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stripe": "^22.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.1-alpha.4",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.119.0"
  }
}
