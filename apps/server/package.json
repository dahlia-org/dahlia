{
  "name": "@dahlia-ai/server",
  "version": "0.1.0",
  "type": "module",
  "description": "Self-hostable authenticated Responses gateway for Dahlia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dahlia-org/dahlia.git",
    "directory": "apps/server"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./node": {
      "types": "./dist/server/node-api.d.ts",
      "import": "./dist/server/node-api.js"
    },
    "./client": {
      "types": "./dist/client-library/index.d.ts",
      "import": "./dist/client-library/index.js"
    },
    "./client/styles.css": "./dist/client-library/styles.css",
    "./client/index.html": "./dist/client/index.html",
    "./client/assets/*": "./dist/client/assets/*",
    "./migrations": {
      "types": "./dist/server/migrations.d.ts",
      "import": "./dist/server/migrations.js"
    },
    "./migrations/sqlite/*": "./drizzle/sqlite/*",
    "./migrations/postgres/*": "./drizzle/postgres/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/client",
    "dist/client-library",
    "dist/server",
    "drizzle"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm run build:client && pnpm run build:server && pnpm run build:library-client",
    "build:client": "vite build",
    "build:cloudflare": "pnpm run ensure:wrangler && WRANGLER_WRITE_LOGS=false WRANGLER_SEND_METRICS=false vite build --config vite.cloudflare.config.ts",
    "build:server": "tsup --config tsup.config.ts",
    "build:library-client": "tsup --config tsup.client.config.ts && cp src/client/styles.css dist/client-library/styles.css",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run test:package && pnpm run worker:dry-run",
    "db:generate": "pnpm run db:generate:postgres && pnpm run db:generate:sqlite",
    "db:generate:postgres": "drizzle-kit generate --config drizzle.config.ts",
    "db:generate:sqlite": "drizzle-kit generate --config drizzle.sqlite.config.ts",
    "db:generate-auth": "node scripts/generate-auth-schema.mjs",
    "db:migrate": "tsx --env-file-if-exists=.env.local src/db/migrate.ts",
    "db:migrate:d1:local": "pnpm run ensure:wrangler && WRANGLER_WRITE_LOGS=false WRANGLER_SEND_METRICS=false wrangler d1 migrations apply dahlia_db_prod --local",
    "db:migrate:prod": "node dist/server/db/migrate.js",
    "dev": "concurrently -k -n api,web \"pnpm run dev:api\" \"pnpm run dev:client\"",
    "dev:api": "tsx watch --env-file-if-exists=.env.local src/node.ts",
    "dev:client": "vite",
    "dev:cloudflare": "pnpm run ensure:wrangler && WRANGLER_WRITE_LOGS=false WRANGLER_SEND_METRICS=false vite dev --config vite.cloudflare.config.ts",
    "ensure:wrangler": "node -e \"const fs=require('node:fs');if(!fs.existsSync('wrangler.jsonc'))fs.copyFileSync('../../deploy/cloudflare/wrangler.example.jsonc','wrangler.jsonc')\"",
    "lint": "eslint .",
    "start": "node dist/server/node.js",
    "start:databricks": "pnpm run db:migrate:prod && pnpm run start",
    "predev": "pnpm run db:migrate",
    "prepack": "pnpm run build",
    "preview:cloudflare": "pnpm run ensure:wrangler && WRANGLER_WRITE_LOGS=false WRANGLER_SEND_METRICS=false vite preview --config vite.cloudflare.config.ts",
    "test": "vitest run",
    "test:package": "node scripts/verify-package.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "worker:dev": "pnpm run dev:cloudflare",
    "worker:dry-run": "pnpm run build:cloudflare && WRANGLER_WRITE_LOGS=false WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --outdir dist/worker",
    "worker:types": "pnpm run ensure:wrangler && WRANGLER_WRITE_LOGS=false WRANGLER_SEND_METRICS=false wrangler types worker-configuration.d.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.1",
    "@better-auth/oauth-provider": "1.7.1",
    "@databricks/lakebase": "0.5.0",
    "@hono/node-server": "^2.1.0",
    "aws4fetch": "1.0.20",
    "better-auth": "1.7.1",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.0",
    "pg": "8.18.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "auth": "1.7.1",
    "concurrently": "^10.0.4",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^10.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.1-alpha.4",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.119.0"
  }
}
