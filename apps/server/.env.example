# Authentication and application storage are configured independently.
DAHLIA_AUTH_TYPE=accounts
# Header mode trusts only this proxy-provided email header.
DAHLIA_AUTH_HEADER=X-Forwarded-Email
# Cloudflare Access: DAHLIA_AUTH_HEADER=Cf-Access-Authenticated-User-Email
# Header mode without a proxy: fall back to a fixed local@example.com identity when the
# header above is empty, and accept a value that is not an email. Nothing strips a
# client-supplied header in that setup, so keep it to a machine only you can reach.
# DAHLIA_LOCAL_SINGLE_USER=1
# Better Auth account.provider_id for Header authentication
DAHLIA_AUTH_PROVIDER_ID=external
DAHLIA_APP_URL=http://localhost:5173
DAHLIA_DATABASE_TYPE=sqlite
DAHLIA_DATABASE_URL=file:.data/dahlia-auth.sqlite

# PostgreSQL uses the same URL variable:
# DAHLIA_DATABASE_TYPE=postgres
# DAHLIA_DATABASE_URL=

# Recommended: generate with openssl rand -hex 32.
# Empty: read or create ./dahlia-auth-secret in the process working directory.
DAHLIA_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DAHLIA_OAUTH_REDIRECT_URIS=http://127.0.0.1:1455/oauth/callback,http://localhost:8020

# Optional OpenAI-compatible upstream. Model catalogs are supplied by the backend.
DAHLIA_AI_BACKEND=openai
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# CODEX_AUTO_REVIEW_MODEL=
# Cloudflare account REST API: token needs Account > Workers AI > Read.
# OPENAI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<account-id>/ai/v1
# CLOUDFLARE_AI_GATEWAY_ID=default
# Databricks AI uses DATABRICKS_HOST plus service principal credentials for model discovery, embeddings and image analysis.
# DATABRICKS_HOST=https://<workspace-host>
# DATABRICKS_MODEL_SCHEMA=dahlia.ai
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=

# Optional image analysis and semantic search (Node or Workers + PostgreSQL).
# Cloudflare: DAHLIA_CAPTIONING_MODEL=gpt-4.1, DAHLIA_EMBEDDING_MODEL=@cf/baai/bge-m3 (1024 dimensions).
# Workers also require Queues and IMAGES bindings; see deploy/cloudflare/README.md.
# Empty or unset disables each worker; absent embeddings keep FTS-only search.
DAHLIA_CAPTIONING_MODEL=
DAHLIA_EMBEDDING_MODEL=
DAHLIA_SEARCH_EMBEDDING_DIMENSIONS=1024

# Arbitrary-byte object storage. Node defaults to local storage.
# DAHLIA_STORAGE_BACKEND=local
# DAHLIA_STORAGE_LOCAL_PATH=.data/storage
# Databricks Apps use DAHLIA_STORAGE_BACKEND=databricks plus:
# DAHLIA_STORAGE_DATABRICKS_VOLUME_PATH=/Volumes/dahlia/server/storage
# S3 and compatible services use DAHLIA_STORAGE_BACKEND=s3 plus:
# DAHLIA_STORAGE_S3_BUCKET=
# DAHLIA_STORAGE_S3_ENDPOINT=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Workers use DAHLIA_STORAGE_BACKEND=r2 plus the DAHLIA_STORAGE binding.

# Lakebase: Databricks Apps supplies LAKEBASE_ENDPOINT and PG* from the attached
# postgres resource. @databricks/lakebase refreshes OAuth credentials.
# DAHLIA_DATABASE_TYPE=lakebase
# LAKEBASE_ENDPOINT=projects/.../endpoints/...
# PGHOST=
# PGDATABASE=
# PGPORT=5432
# PGSSLMODE=require
# PGUSER=

# Workers selects D1 or Hyperdrive through DAHLIA_DATABASE_TYPE and the matching
# dahlia_db_prod or HYPERDRIVE binding.
# DAHLIA_DATABASE_TYPE=d1

# Header authentication behind Cloudflare Access,
# oauth2-proxy, or another identity-aware proxy.
# DAHLIA_AUTH_TYPE=header
# DAHLIA_AUTH_HEADER=Cf-Access-Authenticated-User-Email
# The proxy must strip client-supplied headers and the Server must not be directly reachable.
# DAHLIA_LOCAL_SINGLE_USER=1 falls back to local@example.com when that header is empty.

# Optional new-Vault content encryption. Each secret is base64 of 32 random bytes.
# Keep keys outside the database and its backups. IDs are positive integers; gaps are allowed.
# Set an explicit active ID; retain older keys until all live keys AND retained backups are covered.
# DAHLIA_ENCRYPTION_MASTER_KEY_1=<base64-32-byte-secret>
# DAHLIA_ENCRYPTION_MASTER_KEY_3=<base64-32-byte-secret>
# DAHLIA_ENCRYPTION_ACTIVE_KEY_ID=3
