"help.howItWorks.summary.selectionCandidates" = "When summarizing: up to %lld candidates are taken evenly across the meeting.";
"help.howItWorks.summary.selectionModel" = "An image model keeps one image per shared slide, document, or screen (up to %lld). Faces, camera video, and blank screens are left out.";

