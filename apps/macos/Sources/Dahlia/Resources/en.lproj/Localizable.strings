"help.howItWorks.mcp.data" = "Workspace data";
"help.howItWorks.mcp.meetings" = "Meetings";
"help.howItWorks.mcp.meetingsCaption" = "Summaries, transcripts, events";
"help.howItWorks.mcp.projects" = "Projects";
"help.howItWorks.mcp.accessTitle" = "Read-only by default";
"help.howItWorks.mcp.readOnly" = "Read";
"help.howItWorks.mcp.optIn" = "Only if you allow it";
"help.howItWorks.mcp.write" = "Write";
"help.howItWorks.mcp.accessBody" = "The default configuration lets AI apps read meetings, summaries, finalized transcripts, screenshots, and projects across all available Workspaces. Before copying the configuration, you can limit access to one Workspace. Allowing writes also lets clients update meeting details, replace stored summaries, and create or edit projects.";
"help.howItWorks.mcp.notShared" = "Audio, notes, translations, and transcripts that are not finalized are never shared.";
"help.howItWorks.mcp.setupTitle" = "How to connect";
"help.howItWorks.mcp.setupBody" = "Choose your AI app under Dahlia MCP in Settings to see the command or configuration to register. Copy it into the AI app.";
