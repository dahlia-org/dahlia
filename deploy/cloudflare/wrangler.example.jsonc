{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dahlia-server",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/.well-known/*",
      "/healthz"
    ]
  },
  "d1_databases": [
    {
      "binding": "dahlia_db_prod",
      "database_name": "replace-with-d1-database-name",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle/sqlite",
      "migrations_pattern": "drizzle/sqlite/*/migration.sql"
    }
  ],
  "r2_buckets": [{
    "binding": "DAHLIA_STORAGE",
    "bucket_name": "replace-with-r2-bucket-name"
  }],
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false,
      "invocation_logs": false
    }
  },
  "vars": {
    "DAHLIA_AI_BACKEND": "cloudflare",
    "DAHLIA_STORAGE_BACKEND": "r2",
    "DAHLIA_ARTIFACT_MAX_BYTES": "67108864",
    "DAHLIA_AUTH_TYPE": "accounts",
    "DAHLIA_DATABASE_TYPE": "d1",
    "DAHLIA_APP_URL": "https://{name}.{subdomain}.workers.dev",
    "GOOGLE_CLIENT_ID": "replace-with-google-client-id"
  }
}
