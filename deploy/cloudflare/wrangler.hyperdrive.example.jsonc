{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dahlia-server",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/.well-known/*",
      "/mcp",
      "/healthz"
    ]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DAHLIA_STORAGE",
      "bucket_name": "replace-with-r2-bucket-name"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false,
      "invocation_logs": false
    }
  },
  "vars": {
    "DAHLIA_AI_BACKEND": "cloudflare",
    "DAHLIA_STORAGE_BACKEND": "r2",
    "DAHLIA_AUTH_TYPE": "accounts",
    "DAHLIA_DATABASE_TYPE": "hyperdrive",
    "DAHLIA_APP_URL": "https://{name}.{subdomain}.workers.dev",
    "GOOGLE_CLIENT_ID": "replace-with-google-client-id",
    "CLOUDFLARE_AI_GATEWAY_ID": "default",
    "DAHLIA_CAPTIONING_MODEL": "gpt-4.1",
    "DAHLIA_EMBEDDING_MODEL": "@cf/baai/bge-m3",
    "DAHLIA_SEARCH_EMBEDDING_DIMENSIONS": "1024"
  },
  "images": {
    "binding": "IMAGES"
  },
  "limits": {
    "cpu_ms": 300000
  },
  "queues": {
    "producers": [
      {
        "binding": "DAHLIA_SUMMARY_QUEUE",
        "queue": "dahlia-summary"
      },
      {
        "binding": "DAHLIA_IMAGE_QUEUE",
        "queue": "dahlia-image"
      },
      {
        "binding": "DAHLIA_SEARCH_QUEUE",
        "queue": "dahlia-search"
      }
    ],
    "consumers": [
      {
        "queue": "dahlia-summary",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_retries": 3,
        "dead_letter_queue": "dahlia-summary-dlq"
      },
      {
        "queue": "dahlia-image",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_retries": 3,
        "dead_letter_queue": "dahlia-image-dlq"
      },
      {
        "queue": "dahlia-search",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_retries": 3,
        "dead_letter_queue": "dahlia-search-dlq"
      }
    ]
  }
}
