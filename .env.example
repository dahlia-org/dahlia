# macOS development and release tooling
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
TELEMETRYDECK_APP_ID=
APPLE_TEAM_ID=

# Dahlia Server
# DAHLIA_RUNTIME selects a consistent authentication, database, and Gateway
# preset. It defaults to custom and may be omitted for local development.
DAHLIA_RUNTIME=custom

# custom: accounts + SQLite + custom OpenAI-compatible Gateway.
# Only the custom runtime allows these two overrides:
# DAHLIA_AUTH_PROVIDER=accounts
# DAHLIA_BASE_URL=http://localhost:5173
# DAHLIA_AUTH_DATABASE=sqlite
# DAHLIA_AUTH_SQLITE_PATH=.data/dahlia-auth.sqlite

# Set DAHLIA_AUTH_DATABASE=postgres and DATABASE_URL to store authentication,
# Model Aliases, and administrators in PostgreSQL.
# DATABASE_URL=

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DAHLIA_OAUTH_REDIRECT_URIS=http://127.0.0.1:1455/oauth/callback

# Optional bootstrap administrator. Additional administrators and Model Aliases
# are managed under /admin. An empty administrator list is allowed.
# DAHLIA_ADMIN_EMAIL=admin@example.com

# Optional OpenAI-compatible upstream for every runtime. Configure public Model
# Aliases and their upstream models under /admin/models.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Databricks runtime: header auth + PostgreSQL/Lakebase. Databricks Apps injects
# the host and service-principal credentials used only for Lakebase access.
# DAHLIA_RUNTIME=databricks
# ENDPOINT_NAME and PG* values are supplied by the attached Lakebase resource.
# DATABRICKS_HOST=https://<workspace-host>
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=

# Cloudflare runtime: accounts + D1. Set OPENAI_BASE_URL to the account-level
# Cloudflare AI Gateway REST API and OPENAI_API_KEY to its API token.
# DAHLIA_RUNTIME=cloudflare

# Header authentication for a custom runtime behind Cloudflare Access,
# oauth2-proxy, or another identity-aware proxy.
# DAHLIA_AUTH_PROVIDER=header
# DAHLIA_AUTH_HEADER=Cf-Access-Authenticated-User-Email
# Required outside localhost so direct requests cannot forge the identity header.
# DAHLIA_TRUSTED_PROXY_CIDRS=10.0.0.0/8
