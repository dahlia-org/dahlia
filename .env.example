# macOS development and release tooling
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
TELEMETRYDECK_APP_ID=
APPLE_TEAM_ID=

# Dahlia Server
# Authentication and application storage are configured independently.
DAHLIA_AUTH_TYPE=accounts
DAHLIA_APP_URL=http://localhost:5173
DAHLIA_DATABASE_TYPE=sqlite
DAHLIA_DATABASE_URL=file:.data/dahlia-auth.sqlite

# PostgreSQL uses the same URL variable:
# DAHLIA_DATABASE_TYPE=postgres
# DAHLIA_DATABASE_URL=

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DAHLIA_OAUTH_REDIRECT_URIS=http://127.0.0.1:1455/oauth/callback

# Optional bootstrap administrator. Additional administrators and Model Aliases
# are managed under /admin. An empty administrator list is allowed.
# DAHLIA_ADMIN_EMAIL=admin@example.com

# Optional OpenAI-compatible upstream. Configure public Model
# Aliases and their upstream models under /admin/models.
DAHLIA_AI_BACKEND=openai
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Arbitrary-byte object storage. Node defaults to local storage.
# DAHLIA_STORAGE_BACKEND=local
# DAHLIA_STORAGE_LOCAL_PATH=.data/storage
# Databricks Apps use DAHLIA_STORAGE_BACKEND=databricks plus:
# DAHLIA_STORAGE_DATABRICKS_VOLUME_PATH=/Volumes/main/default/dahlia_artifacts_dev
# S3 and compatible services use DAHLIA_STORAGE_BACKEND=s3 plus:
# DAHLIA_STORAGE_S3_BUCKET=
# DAHLIA_STORAGE_S3_ENDPOINT=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# DAHLIA_ARTIFACT_MAX_BYTES=67108864
# Workers use DAHLIA_STORAGE_BACKEND=r2 plus the DAHLIA_STORAGE binding.

# Lakebase: Databricks Apps supplies LAKEBASE_ENDPOINT and PG* from the attached
# postgres resource. @databricks/lakebase refreshes OAuth credentials.
# DAHLIA_DATABASE_TYPE=lakebase
# LAKEBASE_ENDPOINT=projects/.../endpoints/...
# PGHOST=
# PGDATABASE=
# PGPORT=5432
# PGSSLMODE=require
# PGUSER=

# Workers selects D1 or Hyperdrive through DAHLIA_DATABASE_TYPE and the matching
# dahlia_db_prod or HYPERDRIVE binding.
# DAHLIA_DATABASE_TYPE=d1

# Header authentication behind Cloudflare Access,
# oauth2-proxy, or another identity-aware proxy.
# DAHLIA_AUTH_TYPE=header
# DAHLIA_AUTH_HEADER=Cf-Access-Authenticated-User-Email
# The proxy must strip client-supplied headers and the Server must not be directly reachable.
